<form class="{{cssClass}} loa-character-sheet" autocomplete="off">
  <section class="loa-shell">
    <aside class="loa-sidebar">
      <div class="loa-portrait-wrap">
        <img class="loa-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      </div>

      <input class="loa-name" name="name" type="text" value="{{actor.name}}" />

      <div class="loa-subtitle">
        <span>{{actor.type}}</span>
        <span>Legends of Arxanum</span>
      </div>

      <nav class="loa-tabs" data-group="primary">
        <a class="item active" data-tab="main">Übersicht</a>
        <a class="item" data-tab="combat">Kampf</a>
        <a class="item" data-tab="magic">Magie</a>
        <a class="item" data-tab="story">Story</a>
      </nav>
    </aside>

    <main class="loa-content">
      <section class="tab active" data-group="primary" data-tab="main">
        <div class="loa-grid">
          <div class="loa-card loa-card-wide">
            <h2>Ressourcen</h2>

            <div class="loa-resource">
              <label>Lebenspunkte</label>
              <div>
                <input name="system.resources.hp.value" type="number" value="{{system.resources.hp.value}}" />
                <span>/</span>
                <input name="system.resources.hp.max" type="number" value="{{system.resources.hp.max}}" />
              </div>
            </div>

            <div class="loa-bar">
              <div style="width: 65%"></div>
            </div>

            <div class="loa-resource">
              <label>Resonanz</label>
              <div>
                <input name="system.resources.resonance.value" type="number" value="{{system.resources.resonance.value}}" />
                <span>/</span>
                <input name="system.resources.resonance.max" type="number" value="{{system.resources.resonance.max}}" />
              </div>
            </div>

            <div class="loa-bar loa-bar-magic">
              <div style="width: 55%"></div>
            </div>
          </div>

          <div class="loa-card">
            <h2>Status</h2>
            <div class="loa-pill-row">
              <span class="loa-pill">Bereit</span>
              <span class="loa-pill">Fokussiert</span>
              <span class="loa-pill danger">Instabil</span>
            </div>
          </div>

          <div class="loa-card loa-card-wide">
            <h2>Attribute</h2>

            <div class="loa-attributes">
              {{#each system.attributes as |attribute key|}}
                <div class="loa-attr">
                  <label>{{key}}</label>
                  <input name="system.attributes.{{key}}.value" type="number" value="{{attribute.value}}" />
                </div>
              {{/each}}
            </div>
          </div>
        </div>
      </section>

      <section class="tab" data-group="primary" data-tab="combat">
        <div class="loa-card">
          <h2>Kampf</h2>
          <p class="loa-muted">Hier landen später Waffen, Rüstung, Initiative, Schadensreduktion und Kampfaktionen.</p>
        </div>
      </section>

      <section class="tab" data-group="primary" data-tab="magic">
        <div class="loa-card">
          <h2>Magie</h2>
          <p class="loa-muted">Hier landen später Zauber, Resonanzkosten, Rituale und arkane Effekte.</p>
        </div>
      </section>

      <section class="tab" data-group="primary" data-tab="story">
        <div class="loa-card">
          <h2>Charaktergeschichte</h2>
          <textarea name="system.biography">{{system.biography}}</textarea>
        </div>
      </section>
    </main>
  </section>
</form>