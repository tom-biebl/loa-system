<form class="{{cssClass}} loa-character-sheet" autocomplete="off">
  <section class="loa-shell">
    <aside class="loa-sidebar">
      <div class="loa-portrait-wrap">
        <img class="loa-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      </div>

      <input class="loa-name" name="name" type="text" value="{{actor.name}}" />

      <div class="loa-subtitle">
        <span>{{actor.type}}</span>
        <span>Level {{system.level}}</span>
      </div>

      <div class="loa-stat-strip">
        <div class="loa-stat">
          <span class="loa-stat-label">AC</span>
          <span class="loa-stat-value">{{viewModel.ac.value}}</span>
        </div>
        {{#each viewModel.resources as |resource|}}
          <div class="loa-stat loa-stat-{{resource.key}}">
            <span class="loa-stat-label">{{resource.label}}</span>
            <span class="loa-stat-value">{{resource.value}} / {{resource.max}}</span>
          </div>
        {{/each}}
      </div>

      <nav class="loa-tabs" data-group="primary">
        <a class="item active" data-tab="main">Übersicht</a>
        <a class="item" data-tab="inventory">Rucksack</a>
        <a class="item" data-tab="combat">Kampf</a>
        <a class="item" data-tab="magic">Magie</a>
        <a class="item" data-tab="story">Story</a>
      </nav>
    </aside>

    <main class="loa-content">

      {{!-- ÜBERSICHT --}}
      <section class="tab active" data-group="primary" data-tab="main">
        <div class="loa-grid">
          <div class="loa-card loa-card-wide">
            <h2>Attribute</h2>
            <p class="loa-muted loa-mini">
              Point-Buy: {{viewModel.pointBuy.spent}} / {{viewModel.pointBuy.total}}
              ({{viewModel.pointBuy.remaining}} übrig)
            </p>
            <div class="loa-attributes">
              {{#each viewModel.attributes as |attribute|}}
                <div class="loa-attr">
                  <label>{{attribute.label}}</label>
                  <input name="system.attributes.{{attribute.key}}.value" type="number" value="{{attribute.value}}" />
                  <button type="button" class="loa-mod-btn" data-action="roll-attribute" data-attribute="{{attribute.key}}" title="Wurf {{attribute.label}}">
                    {{attribute.modifierLabel}}
                  </button>
                  <span class="loa-cost">{{attribute.costAtLevel}} pt</span>
                </div>
              {{/each}}
            </div>
          </div>

          <div class="loa-card">
            <h2>Action Economy</h2>
            <div class="loa-pill-row">
              <span class="loa-pill">Aktion {{viewModel.actionEconomy.actions.value}}/{{viewModel.actionEconomy.actions.max}}</span>
              <span class="loa-pill">Bonus {{viewModel.actionEconomy.bonusActions.value}}/{{viewModel.actionEconomy.bonusActions.max}}</span>
              <span class="loa-pill">Reaktion {{viewModel.actionEconomy.reactions.value}}/{{viewModel.actionEconomy.reactions.max}}</span>
            </div>
          </div>

          <div class="loa-card">
            <h2>Rüstungsklasse</h2>
            <div class="loa-ac-display">
              <div class="loa-ac-shield">
                <span class="loa-ac-value">{{viewModel.ac.value}}</span>
              </div>
              <div class="loa-ac-detail">
                <p>Rüstung +{{viewModel.ac.armor}}</p>
                <p>Dex {{#if (gt viewModel.ac.dex 0)}}+{{/if}}{{viewModel.ac.dex}}</p>
                {{#if viewModel.ac.bonus}}
                  <p>Bonus {{#if (gt viewModel.ac.bonus 0)}}+{{/if}}{{viewModel.ac.bonus}}</p>
                {{/if}}
                {{#unless viewModel.equippedArmor}}
                  <p class="loa-muted">Keine Rüstung getragen.</p>
                {{/unless}}
              </div>
            </div>
          </div>
        </div>
      </section>

      {{!-- RUCKSACK --}}
      <section class="tab" data-group="primary" data-tab="inventory">
        <div class="loa-grid">
          <div class="loa-card">
            <h2>Rüstung</h2>
            <div class="loa-armor-slot loa-dropzone" data-drop-zone="armor">
              {{#if viewModel.equippedArmor}}
                <div class="loa-armor-equipped loa-draggable" data-item-id="{{viewModel.equippedArmor.id}}">
                  <img src="{{viewModel.equippedArmor.img}}" data-action="open-item" />
                  <div class="loa-armor-meta">
                    <strong>{{viewModel.equippedArmor.name}}</strong>
                    <span>+{{viewModel.equippedArmor.acBonus}} AC</span>
                  </div>
                  <button type="button" class="loa-action-btn" data-action="unequip-armor" data-item-id="{{viewModel.equippedArmor.id}}">Ablegen</button>
                </div>
              {{else}}
                <div class="loa-armor-empty">
                  <span>Rüstung hierher ziehen</span>
                </div>
              {{/if}}
            </div>
          </div>

          <div class="loa-card loa-card-wide">
            <h2>
              Rucksack
              <span class="loa-muted loa-mini">
                {{viewModel.inventory.used}} / {{viewModel.inventory.capacity}} Slots belegt
              </span>
            </h2>
            <div class="loa-search-wrap">
              <input
                type="search"
                class="loa-search"
                data-loa-search="backpack"
                placeholder="Im Rucksack suchen…"
                autocomplete="off"
              />
            </div>
            <div class="loa-backpack loa-dropzone" data-drop-zone="backpack">
              <div class="loa-backpack-grid">
                {{#each viewModel.inventory.slots as |slot|}}
                  {{#if slot.item}}
                    <div class="loa-slot filled loa-draggable"
                         data-item-id="{{slot.item.id}}"
                         data-search-haystack="{{slot.item.name}} {{slot.item.type}} {{slot.item.description}}"
                         title="{{slot.item.name}}">
                      <img src="{{slot.item.img}}" data-action="open-item" />
                      <span class="loa-slot-name">{{slot.item.name}}</span>
                      {{#if (eq slot.item.type 'weapon')}}
                        <button type="button" class="loa-slot-action loa-slot-attack" data-action="attack-weapon" data-item-id="{{slot.item.id}}" title="Angreifen">⚔</button>
                      {{/if}}
                      {{#if (eq slot.item.type 'armor')}}
                        <button type="button" class="loa-slot-action" data-action="equip-armor" data-item-id="{{slot.item.id}}" title="Anlegen">🛡</button>
                      {{/if}}
                      <button type="button" class="loa-slot-trash" data-action="delete-item" data-item-id="{{slot.item.id}}" title="Löschen">✕</button>
                    </div>
                  {{else}}
                    <div class="loa-slot empty" data-search-empty="1">
                      <span class="loa-slot-empty">·</span>
                    </div>
                  {{/if}}
                {{/each}}
              </div>
            </div>
          </div>
        </div>
      </section>

      {{!-- KAMPF --}}
      <section class="tab" data-group="primary" data-tab="combat">
        <div class="loa-card">
          <h2>Waffen</h2>
          {{#if viewModel.weapons.length}}
            <div class="loa-weapon-list">
              {{#each viewModel.weapons as |weapon|}}
                <div class="loa-weapon-row loa-draggable" data-item-id="{{weapon.id}}">
                  <img src="{{weapon.img}}" data-action="open-item" />
                  <div class="loa-weapon-meta">
                    <strong>{{weapon.name}}</strong>
                    <span class="loa-muted">{{weapon.damage}} {{weapon.damageType}} · {{weapon.range}} · {{weapon.attribute}}</span>
                  </div>
                  <button type="button" class="loa-action-btn" data-action="attack-weapon" data-item-id="{{weapon.id}}">Angreifen</button>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="loa-muted">Keine Waffen im Inventar.</p>
          {{/if}}
        </div>

        <div class="loa-card">
          <h2>Action Economy</h2>
          <div class="loa-pill-row">
            <span class="loa-pill">Aktion {{viewModel.actionEconomy.actions.value}}/{{viewModel.actionEconomy.actions.max}}</span>
            <span class="loa-pill">Bonus {{viewModel.actionEconomy.bonusActions.value}}/{{viewModel.actionEconomy.bonusActions.max}}</span>
            <span class="loa-pill">Reaktion {{viewModel.actionEconomy.reactions.value}}/{{viewModel.actionEconomy.reactions.max}}</span>
          </div>
        </div>
      </section>

      {{!-- MAGIE --}}
      <section class="tab" data-group="primary" data-tab="magic">
        <div class="loa-card">
          <h2>Resonanz</h2>
          {{#if viewModel.resonance.triggered}}
            <p>Aktive Schwelle: <strong>{{viewModel.resonance.threshold}}</strong></p>
            {{#if viewModel.resonance.damageBonus}}
              <p>Schadensbonus: {{viewModel.resonance.damageBonus}}</p>
            {{/if}}
            {{#if viewModel.resonance.rangeBonus}}
              <p>Reichweite/AOE +{{viewModel.resonance.rangeBonus}} ft.</p>
            {{/if}}
            {{#if viewModel.resonance.requiresStabilityCheck}}
              <p class="loa-warn">Stabilitätswurf gegen DC {{viewModel.resonance.dc}} erforderlich.</p>
            {{/if}}
          {{else}}
            <p class="loa-muted">Keine Schwelle aktiv.</p>
          {{/if}}

          <div class="loa-spellcasting">
            <label>Zauberattribut</label>
            <select name="system.spellcasting.ability">
              <option value="int" {{#if (eq system.spellcasting.ability 'int')}}selected{{/if}}>Intelligenz</option>
              <option value="wis" {{#if (eq system.spellcasting.ability 'wis')}}selected{{/if}}>Weisheit</option>
              <option value="cha" {{#if (eq system.spellcasting.ability 'cha')}}selected{{/if}}>Charisma</option>
            </select>
          </div>
        </div>

        <div class="loa-card loa-card-wide">
          <h2>Spellbook</h2>
          <div class="loa-spellbook loa-dropzone" data-drop-zone="spellbook">
            {{#if viewModel.spellbook.length}}
              <div class="loa-spell-grid">
                {{#each viewModel.spellbook as |spell|}}
                  <div class="loa-spell-tile loa-draggable" data-item-id="{{spell.id}}">
                    <img src="{{spell.img}}" data-action="open-item" title="{{spell.name}}" />
                    <div class="loa-spell-meta">
                      <strong>{{spell.name}}</strong>
                      <span class="loa-muted">
                        {{#if spell.isCantrip}}Cantrip{{else}}Stufe {{spell.level}} · {{spell.resonanceCost}} RP{{/if}}
                      </span>
                    </div>
                    <button type="button" class="loa-action-btn" data-action="cast-spell" data-item-id="{{spell.id}}">Wirken</button>
                    <button type="button" class="loa-slot-trash" data-action="delete-item" data-item-id="{{spell.id}}" title="Entfernen">✕</button>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <div class="loa-spellbook-empty">Zauber hierher ziehen</div>
            {{/if}}
          </div>
        </div>
      </section>

      {{!-- STORY --}}
      <section class="tab" data-group="primary" data-tab="story">
        <div class="loa-card">
          <h2>Charaktergeschichte</h2>
          <textarea name="system.biography">{{system.biography}}</textarea>
        </div>
      </section>

    </main>
  </section>
</form>
