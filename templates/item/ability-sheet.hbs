<form class="{{cssClass}} loa-item-sheet loa-ability-sheet" autocomplete="off">
  <header class="loa-item-header">
    <img class="loa-item-img" src="{{item.img}}" data-edit="img" />
    <div>
      <input class="loa-item-name" name="name" type="text" value="{{item.name}}" />
      <span class="loa-item-type">Fähigkeit</span>
    </div>
  </header>

  <section class="loa-item-body">
    <div class="loa-field-grid">
      <label>Effekt-Art
        <select name="system.effectKind">
          <option value="damage"   {{#if (eq system.effectKind 'damage')}}selected{{/if}}>Schaden</option>
          <option value="heal"     {{#if (eq system.effectKind 'heal')}}selected{{/if}}>Heilung</option>
          <option value="utility"  {{#if (eq system.effectKind 'utility')}}selected{{/if}}>Utility (Chat)</option>
          <option value="reaction" {{#if (eq system.effectKind 'reaction')}}selected{{/if}}>Reaktion (Schadensreduktion)</option>
        </select>
      </label>
      <label>Aktionskosten
        <select name="system.actionCost">
          <option value="action"   {{#if (eq system.actionCost 'action')}}selected{{/if}}>Aktion</option>
          <option value="bonus"    {{#if (eq system.actionCost 'bonus')}}selected{{/if}}>Bonusaktion</option>
          <option value="reaction" {{#if (eq system.actionCost 'reaction')}}selected{{/if}}>Reaktion</option>
          <option value="free"     {{#if (eq system.actionCost 'free')}}selected{{/if}}>Kostenlos</option>
        </select>
      </label>
      <label>Cooldown
        <input name="system.cooldown" type="text" value="{{system.cooldown}}" />
      </label>
    </div>

    {{#if (eq system.effectKind 'damage')}}
      <fieldset class="loa-effect-fields">
        <legend>Schaden</legend>
        <div class="loa-field-grid">
          <label>Formel
            <input name="system.damage" type="text" value="{{system.damage}}" placeholder="2d6" />
          </label>
          <label>Schadensart
            <input name="system.damageType" type="text" value="{{system.damageType}}" />
          </label>
          <label>Standard-Reaktions-DC
            <input name="system.reactionDC" type="number" min="0" value="{{system.reactionDC}}" />
          </label>
        </div>
      </fieldset>
    {{/if}}

    {{#if (eq system.effectKind 'heal')}}
      <fieldset class="loa-effect-fields">
        <legend>Heilung</legend>
        <div class="loa-field-grid">
          <label>Heilungs-Formel
            <input name="system.healFormula" type="text" value="{{system.healFormula}}" placeholder="1d6 + 2" />
          </label>
        </div>
        <p class="loa-muted loa-mini">Heilt das anvisierte Token oder den Anwender, wenn nichts anvisiert ist.</p>
      </fieldset>
    {{/if}}

    {{#if (eq system.effectKind 'utility')}}
      <p class="loa-muted loa-mini">
        Utility-Fähigkeiten posten beim Verwenden nur eine Chat-Nachricht mit der Beschreibung.
      </p>
    {{/if}}

    {{#if (eq system.effectKind 'reaction')}}
      <fieldset class="loa-effect-fields loa-effect-reaction">
        <legend>Reaktion</legend>
        <div class="loa-field-grid">
          <label>Modus
            <select name="system.reactionMode">
              <option value="flat"    {{#if (eq system.reactionMode 'flat')}}selected{{/if}}>Fester Wert (Block)</option>
              <option value="rolled"  {{#if (eq system.reactionMode 'rolled')}}selected{{/if}}>Wurf vs DC (Reduktion auf Erfolg)</option>
              <option value="counter" {{#if (eq system.reactionMode 'counter')}}selected{{/if}}>Gegenzauber (Negation auf Erfolg)</option>
            </select>
          </label>
          <label>Reduktions-Formel
            <input name="system.reactionFormula" type="text" value="{{system.reactionFormula}}" placeholder="5 oder 1d6" />
          </label>
          <label>Wurf-Attribut
            <select name="system.reactionAttribute">
              <option value="str" {{#if (eq system.reactionAttribute 'str')}}selected{{/if}}>Stärke</option>
              <option value="dex" {{#if (eq system.reactionAttribute 'dex')}}selected{{/if}}>Geschick</option>
              <option value="con" {{#if (eq system.reactionAttribute 'con')}}selected{{/if}}>Konstitution</option>
              <option value="int" {{#if (eq system.reactionAttribute 'int')}}selected{{/if}}>Intelligenz</option>
              <option value="wis" {{#if (eq system.reactionAttribute 'wis')}}selected{{/if}}>Weisheit</option>
              <option value="cha" {{#if (eq system.reactionAttribute 'cha')}}selected{{/if}}>Charisma</option>
            </select>
          </label>
        </div>
        <p class="loa-muted loa-mini">
          Reaktionen werden über die Pending-Damage-Karte des Ziels ausgelöst, nicht direkt verwendet.
          <strong>Fester Wert:</strong> Reduktion = Formel (z.B. „5" für Block).
          <strong>Wurf vs DC:</strong> 1d20 + Attribut gegen die Cast-DC; bei Erfolg Reduktion = Formel.
          <strong>Gegenzauber:</strong> bei Erfolg wird der gesamte Schaden negiert.
        </p>
      </fieldset>
    {{/if}}

    <label>Beschreibung</label>
    <textarea name="system.description">{{system.description}}</textarea>
  </section>
</form>
