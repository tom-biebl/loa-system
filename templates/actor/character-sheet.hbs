<form class="{{cssClass}} loa-character-sheet" autocomplete="off">
  <section class="loa-shell">
    <aside class="loa-sidebar">
      <div class="loa-portrait-wrap">
        <img class="loa-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      </div>

      <input class="loa-name" name="name" type="text" value="{{actor.name}}" />

      <div class="loa-subtitle">
        <span>{{viewModel.class.label}}</span>
        <span>Level {{system.level}}</span>
      </div>

      <div class="loa-class-block">
        <label class="loa-class-label">Klasse</label>
        <select name="system.class.key" data-loa-action="class-change">
          {{#each viewModel.class.options as |option|}}
            <option value="{{option.key}}" {{#if (eq option.key ../viewModel.class.key)}}selected{{/if}}>{{option.label}}</option>
          {{/each}}
        </select>
        {{#if viewModel.class.hasSubclasses}}
          <label class="loa-class-label">Subklasse</label>
          <select name="system.class.subclass">
            <option value="" {{#unless viewModel.class.subclassKey}}selected{{/unless}}>— keine —</option>
            {{#each viewModel.class.subclasses as |sub|}}
              <option value="{{sub.key}}" {{#if (eq sub.key ../viewModel.class.subclassKey)}}selected{{/if}}>{{sub.label}}</option>
            {{/each}}
          </select>
        {{/if}}
      </div>

      <div class="loa-stat-strip">
        <div class="loa-stat">
          <span class="loa-stat-label">AC</span>
          <span class="loa-stat-value">{{viewModel.ac.value}}</span>
        </div>
        {{#each viewModel.resources as |resource|}}
          <div class="loa-stat loa-stat-{{resource.key}}">
            <span class="loa-stat-label">{{resource.label}}</span>
            <span class="loa-stat-value">{{resource.value}} / {{resource.max}}</span>
          </div>
        {{/each}}
      </div>

      <nav class="loa-tabs" data-group="primary">
        <a class="item active" data-tab="main">Übersicht</a>
        <a class="item" data-tab="inventory">Rucksack</a>
        <a class="item" data-tab="combat">Kampf</a>
        <a class="item" data-tab="magic">Magie</a>
        <a class="item" data-tab="experience">Erfahrung</a>
        <a class="item" data-tab="story">Story</a>
      </nav>
    </aside>

    <main class="loa-content">

      {{!-- ÜBERSICHT --}}
      <section class="tab active" data-group="primary" data-tab="main">
        <div class="loa-grid">
          <div class="loa-card loa-card-wide">
            <h2>Attribute</h2>
            <p class="loa-muted loa-mini">
              Point-Buy: {{viewModel.pointBuy.spent}} / {{viewModel.pointBuy.total}}
              ({{viewModel.pointBuy.remaining}} übrig)
            </p>
            <div class="loa-attributes">
              {{#each viewModel.attributes as |attribute|}}
                <div class="loa-attr">
                  <label>{{attribute.label}}</label>
                  <input name="system.attributes.{{attribute.key}}.value" type="number" value="{{attribute.value}}" />
                  <button type="button" class="loa-mod-btn" data-action="roll-attribute" data-attribute="{{attribute.key}}" title="Wurf {{attribute.label}}">
                    {{attribute.modifierLabel}}
                  </button>
                  <span class="loa-cost">{{attribute.costAtLevel}} pt</span>
                </div>
              {{/each}}
            </div>
          </div>

          <div class="loa-card">
            <h2>Rast</h2>
            <div class="loa-rest-actions">
              <button type="button" class="loa-action-btn" data-loa-action="short-rest" title="2d12 HP wiederherstellen und 1d8 Resonanz abbauen">Kleine Rast</button>
              <button type="button" class="loa-action-btn" data-loa-action="long-rest" title="HP vollständig wiederherstellen und Resonanz auf 0 setzen">Große Rast</button>
            </div>
          </div>

          <div class="loa-card">
            <h2>
              Aktionsökonomie
              <button type="button" class="loa-icon-btn" data-loa-action="reset-action-economy" title="Aktionen zurücksetzen">↻</button>
            </h2>
            <div class="loa-action-grid">
              {{#each viewModel.combat.rows as |row|}}
                <div class="loa-action-row" data-action-type="{{row.type}}">
                  <span class="loa-action-label">{{row.label}}</span>
                  <input
                    class="loa-action-current"
                    type="number"
                    min="0"
                    value="{{row.current}}"
                    data-loa-action="set-action-current"
                    data-action-type="{{row.type}}"
                    title="Verbleibende {{row.pluralLabel}}"
                  />
                  <span class="loa-action-divider">/</span>
                  <input
                    class="loa-action-max"
                    type="number"
                    min="0"
                    value="{{row.max}}"
                    data-loa-action="set-action-max"
                    data-action-type="{{row.type}}"
                    title="Max {{row.pluralLabel}}"
                  />
                  <button
                    type="button"
                    class="loa-action-spend"
                    data-loa-action="spend-action"
                    data-action-type="{{row.type}}"
                    title="{{row.label}} verbrauchen"
                  >−</button>
                </div>
              {{/each}}
            </div>
          </div>

          <div class="loa-card">
            <h2>Rüstungsklasse</h2>
            <div class="loa-ac-display">
              <div class="loa-ac-shield">
                <span class="loa-ac-value">{{viewModel.ac.value}}</span>
              </div>
              <div class="loa-ac-detail">
                <p>Rüstung +{{viewModel.ac.armor}}</p>
                <p>Dex {{#if (gt viewModel.ac.dex 0)}}+{{/if}}{{viewModel.ac.dex}}</p>
                {{#if viewModel.ac.bonus}}
                  <p>Bonus {{#if (gt viewModel.ac.bonus 0)}}+{{/if}}{{viewModel.ac.bonus}}</p>
                {{/if}}
                {{#unless viewModel.equippedArmor}}
                  <p class="loa-muted">Keine Rüstung getragen.</p>
                {{/unless}}
              </div>
            </div>
          </div>

          {{#if viewModel.classResources.any}}
            <div class="loa-card loa-card-wide">
              <h2>Klassen-Ressourcen</h2>

              {{#if viewModel.classResources.showResonance}}
                <div class="loa-resource">
                  <label>Resonanz</label>
                  <div>
                    <input name="system.resources.resonance.value" type="number" value="{{system.resources.resonance.value}}" />
                    <span>/</span>
                    <input name="system.resources.resonance.max" type="number" value="{{system.resources.resonance.max}}" />
                  </div>
                </div>
              {{/if}}

              {{#if viewModel.classResources.showSuperiorityDice}}
                <div class="loa-resource">
                  <label>Superiority Dice
                    <input class="loa-superiority-die" name="system.resources.superiorityDice.dice" type="text" value="{{viewModel.classResources.superiorityDice.dice}}" />
                  </label>
                  <div>
                    <input name="system.resources.superiorityDice.current" type="number" value="{{viewModel.classResources.superiorityDice.current}}" />
                    <span>/</span>
                    <input name="system.resources.superiorityDice.max" type="number" value="{{viewModel.classResources.superiorityDice.max}}" />
                  </div>
                </div>
              {{/if}}

              {{#if viewModel.classResources.showAmmo}}
                <div class="loa-class-grid">
                  <label>Pfeile
                    <input name="system.resources.ammo.arrows" type="number" min="0" value="{{viewModel.classResources.ammo.arrows}}" />
                  </label>
                  <label>Bolzen
                    <input name="system.resources.ammo.bolts" type="number" min="0" value="{{viewModel.classResources.ammo.bolts}}" />
                  </label>
                </div>
              {{/if}}

              {{#if viewModel.classResources.showSpecialAmmo}}
                <div class="loa-special-ammo">
                  <h3>Spezialmunition</h3>
                  {{#if viewModel.classResources.specialAmmo.length}}
                    <div class="loa-special-ammo-list">
                      {{#each viewModel.classResources.specialAmmo as |ammo|}}
                        <div class="loa-special-ammo-row" data-special-ammo-index="{{@index}}">
                          <input data-loa-special-ammo-field="label" value="{{ammo.label}}" placeholder="Bezeichnung" />
                          <input data-loa-special-ammo-field="type" value="{{ammo.type}}" placeholder="Typ-Key (z.B. silver_round)" />
                          <input data-loa-special-ammo-field="amount" type="number" min="0" value="{{ammo.amount}}" />
                          <button type="button" class="loa-slot-trash" data-loa-action="remove-special-ammo" title="Entfernen">✕</button>
                        </div>
                      {{/each}}
                    </div>
                  {{else}}
                    <p class="loa-muted loa-mini">Noch keine Spezialmunition.</p>
                  {{/if}}
                  <button type="button" class="loa-action-btn" data-loa-action="add-special-ammo">+ Spezialmunition</button>
                </div>
              {{/if}}

              {{#if viewModel.classResources.showPotions}}
                <div class="loa-potion-belt">
                  <h3>Tränkegürtel ({{viewModel.classResources.potions.slots}} Slots)</h3>
                  <div class="loa-potion-grid">
                    {{#each viewModel.classResources.potionSlotIndices as |idx|}}
                      <div class="loa-potion-slot empty"><span>·</span></div>
                    {{/each}}
                  </div>
                  <p class="loa-muted loa-mini">Drag &amp; Drop kommt mit dem nächsten Update.</p>
                </div>
              {{/if}}

            </div>
          {{/if}}
        </div>
      </section>

      {{!-- RUCKSACK --}}
      <section class="tab" data-group="primary" data-tab="inventory">
        <div class="loa-grid">
          <div class="loa-card">
            <h2>Rüstung</h2>
            <div class="loa-armor-slot loa-dropzone" data-drop-zone="armor">
              {{#if viewModel.equippedArmor}}
                <div class="loa-armor-equipped loa-draggable" data-item-id="{{viewModel.equippedArmor.id}}">
                  <img src="{{viewModel.equippedArmor.img}}" data-action="open-item" />
                  <div class="loa-armor-meta">
                    <strong>{{viewModel.equippedArmor.name}}</strong>
                    <span>+{{viewModel.equippedArmor.acBonus}} AC</span>
                  </div>
                  <button type="button" class="loa-action-btn" data-action="unequip-armor" data-item-id="{{viewModel.equippedArmor.id}}">Ablegen</button>
                </div>
              {{else}}
                <div class="loa-armor-empty">
                  <span>Rüstung hierher ziehen</span>
                </div>
              {{/if}}
            </div>
          </div>

          <div class="loa-card loa-card-wide">
            <h2>
              Rucksack
              <span class="loa-muted loa-mini">
                {{viewModel.inventory.used}} / {{viewModel.inventory.capacity}} Slots belegt
              </span>
            </h2>
            <div class="loa-search-wrap">
              <input
                type="search"
                class="loa-search"
                data-loa-search="backpack"
                placeholder="Im Rucksack suchen…"
                autocomplete="off"
              />
            </div>
            <div class="loa-backpack loa-dropzone" data-drop-zone="backpack">
              <div class="loa-backpack-grid">
                {{#each viewModel.inventory.slots as |slot|}}
                  {{#if slot.item}}
                    <div class="loa-slot filled loa-draggable"
                         data-item-id="{{slot.item.id}}"
                         data-search-haystack="{{slot.item.name}} {{slot.item.type}} {{slot.item.description}}"
                         title="{{slot.item.name}}{{#if slot.item.hasStack}} (×{{slot.item.quantity}}){{/if}}">
                      <img src="{{slot.item.img}}" data-action="open-item" />
                      <span class="loa-slot-name">{{slot.item.name}}</span>
                      {{#if slot.item.hasStack}}
                        <span class="loa-slot-quantity">×{{slot.item.quantity}}</span>
                      {{/if}}
                      {{#if (eq slot.item.type 'weapon')}}
                        <button type="button" class="loa-slot-action loa-slot-attack" data-action="attack-weapon" data-item-id="{{slot.item.id}}" title="Angreifen">⚔</button>
                      {{/if}}
                      {{#if (eq slot.item.type 'armor')}}
                        <button type="button" class="loa-slot-action" data-action="equip-armor" data-item-id="{{slot.item.id}}" title="Anlegen">🛡</button>
                      {{/if}}
                      {{#if (eq slot.item.type 'consumable')}}
                        <button type="button" class="loa-slot-action" data-action="use-consumable" data-item-id="{{slot.item.id}}" title="Verwenden">🧪</button>
                      {{/if}}
                      <button type="button" class="loa-slot-trash" data-action="delete-item" data-item-id="{{slot.item.id}}" title="Löschen">✕</button>
                    </div>
                  {{else}}
                    <div class="loa-slot empty" data-search-empty="1">
                      <span class="loa-slot-empty">·</span>
                    </div>
                  {{/if}}
                {{/each}}
              </div>
            </div>
          </div>
        </div>
      </section>

      {{!-- KAMPF --}}
      <section class="tab" data-group="primary" data-tab="combat">
        <div class="loa-card">
          <h2>Waffen</h2>
          {{#if viewModel.weapons.length}}
            <div class="loa-weapon-list">
              {{#each viewModel.weapons as |weapon|}}
                <div class="loa-weapon-row loa-draggable" data-item-id="{{weapon.id}}">
                  <img src="{{weapon.img}}" data-action="open-item" />
                  <div class="loa-weapon-meta">
                    <strong>{{weapon.name}}</strong>
                    <span class="loa-muted">{{weapon.damage}} {{weapon.damageType}} · {{weapon.range}} · {{weapon.attribute}}</span>
                  </div>
                  <button type="button" class="loa-action-btn" data-action="attack-weapon" data-item-id="{{weapon.id}}">Angreifen</button>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="loa-muted">Keine Waffen im Inventar.</p>
          {{/if}}
        </div>

        <div class="loa-card">
          <h2>Aktionsökonomie
            <button type="button" class="loa-icon-btn" data-loa-action="reset-action-economy" title="Aktionen zurücksetzen">↻</button>
          </h2>
          <div class="loa-pill-row">
            {{#each viewModel.combat.rows as |row|}}
              <span class="loa-pill">{{row.label}} {{row.current}}/{{row.max}}</span>
            {{/each}}
          </div>
        </div>

        <div class="loa-card loa-card-wide">
          <h2>Fähigkeiten</h2>
          {{#if viewModel.abilities.length}}
            <div class="loa-ability-list">
              {{#each viewModel.abilities as |ability|}}
                <div class="loa-ability-row" data-item-id="{{ability.id}}">
                  <img src="{{ability.img}}" data-action="open-item" />
                  <div class="loa-ability-meta">
                    <strong>{{ability.name}}</strong>
                    <span class="loa-muted">
                      {{ability.effectKindLabel}} · {{ability.actionCostLabel}}
                      {{#if ability.reactionSummary}} · {{ability.reactionSummary}}{{/if}}
                    </span>
                  </div>
                  {{#unless ability.isReaction}}
                    <button type="button" class="loa-action-btn" data-action="use-ability" data-item-id="{{ability.id}}">Verwenden</button>
                  {{else}}
                    <span class="loa-pill loa-pill-muted">Reaktiv</span>
                  {{/unless}}
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="loa-muted">Keine Fähigkeiten angelegt. Lege ein Item vom Typ „ability" an.</p>
          {{/if}}
        </div>
      </section>

      {{!-- MAGIE --}}
      <section class="tab" data-group="primary" data-tab="magic">
        <div class="loa-card">
          <h2>Resonanz</h2>
          {{#if viewModel.resonance.triggered}}
            <p>Aktive Schwelle: <strong>{{viewModel.resonance.threshold}}</strong></p>
            {{#if viewModel.resonance.damageBonus}}
              <p>Schadensbonus: {{viewModel.resonance.damageBonus}}</p>
            {{/if}}
            {{#if viewModel.resonance.rangeBonus}}
              <p>Reichweite/AOE +{{viewModel.resonance.rangeBonus}} ft.</p>
            {{/if}}
            {{#if viewModel.resonance.requiresStabilityCheck}}
              <p class="loa-warn">Stabilitätswurf gegen DC {{viewModel.resonance.dc}} erforderlich.</p>
            {{/if}}
          {{else}}
            <p class="loa-muted">Keine Schwelle aktiv.</p>
          {{/if}}

          <div class="loa-spellcasting">
            <label>Zauberattribut</label>
            <select name="system.spellcasting.ability">
              <option value="int" {{#if (eq system.spellcasting.ability 'int')}}selected{{/if}}>Intelligenz</option>
              <option value="wis" {{#if (eq system.spellcasting.ability 'wis')}}selected{{/if}}>Weisheit</option>
              <option value="cha" {{#if (eq system.spellcasting.ability 'cha')}}selected{{/if}}>Charisma</option>
            </select>
          </div>
        </div>

        <div class="loa-card loa-card-wide">
          <h2>Spellbook</h2>
          <div class="loa-spellbook loa-dropzone" data-drop-zone="spellbook">
            {{#if viewModel.spellbook.length}}
              <div class="loa-spell-grid">
                {{#each viewModel.spellbook as |spell|}}
                  <div class="loa-spell-tile loa-draggable" data-item-id="{{spell.id}}">
                    <img src="{{spell.img}}" data-action="open-item" title="{{spell.name}}" />
                    <div class="loa-spell-meta">
                      <strong>{{spell.name}}</strong>
                      <span class="loa-muted">
                        {{#if spell.isCantrip}}Cantrip{{else}}Stufe {{spell.level}} · {{spell.resonanceCost}} RP{{/if}}
                      </span>
                    </div>
                    <button type="button" class="loa-action-btn" data-action="cast-spell" data-item-id="{{spell.id}}">Wirken</button>
                    <button type="button" class="loa-slot-trash" data-action="delete-item" data-item-id="{{spell.id}}" title="Entfernen">✕</button>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <div class="loa-spellbook-empty">Zauber hierher ziehen</div>
            {{/if}}
          </div>
        </div>
      </section>

      {{!-- ERFAHRUNG --}}
      <section class="tab" data-group="primary" data-tab="experience">
        <div class="loa-card loa-card-wide">
          <h2>
            Erfahrung
            <span class="loa-muted loa-mini">{{viewModel.experience.totalCount}} Bereiche</span>
          </h2>

          <div class="loa-experience-add">
            {{#if viewModel.experience.hasAvailable}}
              <select data-loa-experience-pick>
                <option value="">— Bereich wählen —</option>
                {{#each viewModel.experience.available as |group|}}
                  <optgroup label="{{group.category}}">
                    {{#each group.areas as |area|}}
                      <option value="{{area.key}}">{{area.label}}</option>
                    {{/each}}
                  </optgroup>
                {{/each}}
              </select>
              <button type="button" class="loa-action-btn" data-loa-action="add-experience">+ Hinzufügen</button>
            {{else}}
              <p class="loa-muted loa-mini">Alle Bereiche sind bereits hinzugefügt.</p>
            {{/if}}
          </div>

          {{#if viewModel.experience.groups.length}}
            {{#each viewModel.experience.groups as |group|}}
              <h3 class="loa-experience-group">{{group.category}}</h3>
              <div class="loa-experience-list">
                {{#each group.entries as |entry|}}
                  <div class="loa-experience-row" data-experience-key="{{entry.key}}">
                    <span class="loa-experience-name">{{entry.resolvedLabel}}</span>
                    <input
                      class="loa-experience-xp"
                      type="number"
                      min="0"
                      value="{{entry.xp}}"
                      data-loa-experience-xp="{{entry.key}}"
                    />
                    <span class="loa-experience-rank">{{entry.rankInfo.label}}</span>
                    <span class="loa-experience-bonus">{{entry.bonusLabel}}</span>
                    <button
                      type="button"
                      class="loa-slot-trash"
                      data-loa-action="remove-experience"
                      data-experience-key="{{entry.key}}"
                      title="Entfernen"
                    >✕</button>
                  </div>
                {{/each}}
              </div>
            {{/each}}
          {{else}}
            <p class="loa-muted">
              Noch keine Erfahrungsbereiche. Wähle oben einen aus der Liste —
              z.B. drei „Interessen" mit je 5 EP für den Charakterstart.
            </p>
          {{/if}}
        </div>
      </section>

      {{!-- STORY --}}
      <section class="tab" data-group="primary" data-tab="story">
        <div class="loa-card">
          <h2>Charaktergeschichte</h2>
          <textarea name="system.biography">{{system.biography}}</textarea>
        </div>
      </section>

    </main>
  </section>
</form>
